DISPLAY=:0
RM_DISABLE_AUDIO=0

# 可选：指定 client Dockerfile 的基础镜像。
# 网络受限时可改成已经预拉取的本地 tag 或内网镜像，例如:
#   RM26_CLIENT_BASE_IMAGE=rm26-ubuntu-base:24.04
#   RM26_CLIENT_BASE_IMAGE=<your-registry>/library/ubuntu:24.04
RM26_CLIENT_BASE_IMAGE=ubuntu:24.04

# Docker 基础镜像拉取失败时的重试次数与间隔（秒）
RM_DOCKER_PULL_RETRIES=3
RM_DOCKER_PULL_RETRY_DELAY_SEC=5

# 赛事网络地址统一在 config.json 的 network 段配置。
# 修改 config.json 后只需重启客户端，不需要重新构建镜像。

# 以下仅为 Docker 宿主机端口与运行参数，不是赛事引擎地址。
RM_CLIENT_HOST_PORT=3333
RM_VIDEO_HOST_PORT=3334
RM_MQTT_BIND_HOST=127.0.0.1
RM_MQTT_HOST_PORT=3333
RM_ENEMY_TEAM_NAME=示例对手
RM_VIDEO_STREAM_URL=udp://0.0.0.0:3334
