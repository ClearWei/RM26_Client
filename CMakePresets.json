{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "RM_VALIDATE_ASSETS": "ON",
        "RM26_ENABLE_DEVTOOLS": "OFF"
      }
    },
    {
      "name": "dev",
      "displayName": "开发构建",
      "description": "启用测试的本地调试构建",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "发布构建",
      "description": "不启用开发观测接口的发布构建",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci",
      "displayName": "CI 构建",
      "description": "使用 Ninja 和 ccache 的无头持续集成构建",
      "inherits": "release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "devtools",
      "displayName": "开发观测构建",
      "description": "显式链接 Qt HttpServer 并启用本地观测接口",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "RM26_ENABLE_DEVTOOLS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "devtools",
      "configurePreset": "devtools",
      "configuration": "RelWithDebInfo",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
